# Neon development branch connection string. Server-only; never use NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Copy the Auth URL from the SAME development branch in Neon.
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/neondb/auth

# Generate independently for each environment; at least 32 random characters.
NEON_AUTH_COOKIE_SECRET=
